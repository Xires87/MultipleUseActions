{
	"schemaVersion": 1,
	"id": "frycmua",
	"version": "${version}",
	"name": "Multiple use actions",
	"description": "Gives more control over use actions and allows having multiple use actions on a single item",
	"authors": [
		"Wookash Fryc"
	],
	"contact": {
		"homepage": "https://legacy.curseforge.com/minecraft/mc-mods/multiple-use-actions",
		"sources": "https://github.com/Xires87/MultipleUseActions",
		"issues": "https://github.com/Xires87/MultipleUseActions/issues"
	},
	"license": "MIT",
	"icon": "assets/frycmua/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.fryc.frycmua.MultipleUseActions"
		],
		"client": [
			"net.fryc.frycmua.MultipleUseActionsClient"
		],
		"modmenu": [
			"net.fryc.frycmua.screen.ModMenuIntegration"
		]
	},
	"mixins": [
		"frycmua.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}